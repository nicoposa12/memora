# ==========================================
# Memora Docker Compose Environment Config
# ==========================================

# Application
APP_NAME=Memora
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=base64:7K5vO0kP3mR8wX2yZ1qB6nC9jF4hL7sA5eT2uI4oV8w=

# PostgreSQL Database (Container)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=memora
DB_USERNAME=memora_user
DB_PASSWORD=secret_memora_db_pass

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Cloudflare R2 / S3 (Optional for Cloud Storage)
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=your-r2-access-key
# AWS_SECRET_ACCESS_KEY=your-r2-secret-key
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=memora-photos
# AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Xendit Payment Gateway (Optional for Payments)
# XENDIT_SECRET_KEY=xnd_development_...
# XENDIT_CALLBACK_TOKEN=your-webhook-callback-token

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
